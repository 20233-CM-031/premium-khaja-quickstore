# ==============================================================================
# QuickStore by SouqOne — Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS OR SERVICE-ROLE KEYS TO GIT!
# ==============================================================================

# 1. Supabase Backend Connection (Required for Cloud Database & Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Multi-Tenant Default Storefront Identifier
VITE_DEFAULT_TENANT_SLUG=premium-khaja

# 3. Server-Side Privileged Credentials (Used ONLY in Supabase Edge Functions or Netlify Functions)
# NEVER PREFIX PRIVILEGED KEYS WITH VITE_ (Which exposes them in client JavaScript bundles)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Storage & Media Bucket
VITE_SUPABASE_STORAGE_BUCKET=quickstore-media

# 5. External Provider Feature Flags (Set to false or omit until official credentials are provisioned)
VITE_ENABLE_AI_STYLIST=false
VITE_ENABLE_VOICE_COMMANDS=false
VITE_ENABLE_SOCIAL_SYNC=false
